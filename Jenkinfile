pipeline {
    agent any

    environment {
        // Your Docker Hub info
        DOCKER_HUB_USER = 'vviisydh'
        REPO_NAME = 'edart-core'
        // This automatically increments with every Jenkins build (e.g., :1, :2, :3)
        IMAGE_TAG = "${DOCKER_HUB_USER}/${REPO_NAME}:${BUILD_NUMBER}"
        
        KUBECONFIG_ID = 're-k3s'
        REGISTRY_ID = 'REGISTRYCRED' // Your specific Credential ID
    }

    stages {
        stage('Build & Push') {
            steps {
                // Log in and push using your REGISTRYCRED
                withCredentials([usernamePassword(credentialsId: REGISTRY_ID, 
                                                 usernameVariable: 'DUSER', 
                                                 passwordVariable: 'DPASS')]) {
                    sh """
                    echo "Logging into Docker Hub..."
                    echo \$DPASS | docker login -u \$DUSER --password-stdin

                    echo "Building: ${IMAGE_TAG}"
                    docker build -t ${IMAGE_TAG} .

                    echo "Pushing: ${IMAGE_TAG}"
                    docker push ${IMAGE_TAG}
                    
                    docker logout
                    """
                }
            }
        }

        stage('Deploy to K3s') {
            steps {
                withCredentials([file(credentialsId: KUBECONFIG_ID, variable: 'KUBECONFIG_FILE')]) {
                    sh """
                    export KUBECONFIG=\$KUBECONFIG_FILE

                    echo "Updating deployment.yaml with image: ${IMAGE_TAG}"
                    # Replaces the placeholder with the new incremented tag
                    sed -i "s|IMAGE_PLACEHOLDER|${IMAGE_TAG}|g" deployment.yaml

                    kubectl apply -f deployment.yaml
                    
                    echo "Waiting for rollout of version ${BUILD_NUMBER}..."
                    kubectl rollout status deployment/edart-core --timeout=120s
                    """
                }
            }
        }
    }

    post {
        success {
            // Using withCredentials to pull the secret token safely
            withCredentials([string(credentialsId: TELE_CRED_ID, variable: 'TOKEN')]) {
                sh """
                curl -X POST "https://api.telegram.org/${TOKEN}/sendMessage" \
                -H "Content-Type: application/json" \
                -d '{
                    "chat_id": "-1003553584900",
                    "text": "🚀 Deployment Success!✅\\n\\nProject: edart-core\\nVersion: ${BUILD_NUMBER}\\nStatus: Online"
                }'
                """
            }
        }
        fail {
            // Using withCredentials to pull the secret token safely
            withCredentials([string(credentialsId: TELE_CRED_ID, variable: 'TOKEN')]) {
                sh """
                curl -X POST "https://api.telegram.org/${TOKEN}/sendMessage" \
                -H "Content-Type: application/json" \
                -d '{
                    "chat_id": "-1003553584900",
                    "text": "🚀 Deployment Failed!❌\\n\\nProject: edart-core\\nVersion: ${BUILD_NUMBER}\\nStatus: Failed"
                }'
                """
            }
        }
        always {
            // Clean up image to save disk space
            sh "docker rmi ${IMAGE_TAG} || true"
        }
    }
}