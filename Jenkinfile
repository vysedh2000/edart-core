pipeline {
    agent any

    environment {
        DOCKER_HUB_USER = 'vviisydh'
        REPO_NAME = 'edart-core'
        IMAGE_TAG = "${DOCKER_HUB_USER}/${REPO_NAME}:${BUILD_NUMBER}"
        
        KUBECONFIG_ID = 're-k3s'
        REGISTRY_ID = 'REGISTRYCRED'
        // Ensure this matches the ID you created in Jenkins
        TELE_CRED_ID = 'TELEBOT' 
    }

    stages {
        stage('Checkout') {
                    steps {
                        // This pulls the code from the repo linked to this job
                        checkout scm
                    }
        }
        stage('Build & Push') {
            steps {
                withCredentials([usernamePassword(credentialsId: REGISTRY_ID, 
                                                 usernameVariable: 'DUSER', 
                                                 passwordVariable: 'DPASS')]) {
                    sh """
                    echo "Logging into Docker Hub..."
                    echo \$DPASS | docker login -u \$DUSER --password-stdin
                    docker build -t ${IMAGE_TAG} .
                    docker push ${IMAGE_TAG}
                    docker logout
                    """
                }
            }
        }

        stage('Deploy to K3s') {
            steps {
                withCredentials([file(credentialsId: KUBECONFIG_ID, variable: 'KUBECONFIG_FILE')]) {
                    sh """
                    export KUBECONFIG=\$KUBECONFIG_FILE
                    sed -i "s|IMAGE_PLACEHOLDER|${IMAGE_TAG}|g" deployment.yaml
                    kubectl apply -f deployment.yaml
                    kubectl rollout status deployment/edart-core --timeout=120s
                    """
                }
            }
        }
    }

    post {
        success {
            withCredentials([string(credentialsId: TELE_CRED_ID, variable: 'TOKEN')]) {
                sh """
                # Using your format since 'bot' is already in your secret
                curl -X POST "https://api.telegram.org/\${TOKEN}/sendMessage" \
                -H "Content-Type: application/json" \
                -d '{
                    "chat_id": "-1003553584900",
                    "text": "🚀 Deployment Success! ✅\\n\\nProject: edart-core\\nVersion: ${BUILD_NUMBER}"
                }'
                """
            }
        }
        // Fixed keyword: 'failure' instead of 'fail'
        failure {
            withCredentials([string(credentialsId: TELE_CRED_ID, variable: 'TOKEN')]) {
                sh """
                curl -X POST "https://api.telegram.org/\${TOKEN}/sendMessage" \
                -H "Content-Type: application/json" \
                -d '{
                    "chat_id": "-1003553584900",
                    "text": "❌ Deployment Failed! ❌\\n\\nProject: edart-core\\nVersion: ${BUILD_NUMBER}"
                }'
                """
            }
        }
        always {
            sh "docker rmi ${IMAGE_TAG} || true"
        }
    }
}
